{
    "name": "@kartoffelgames/environment-example-app",
    "version": "5.0.1",
    "license": "LGPL-3.0-only",
    "tasks": {},
    "exports": "./page/source/index.ts",
    "imports": {},
    "kg": {
        "name": "Kartoffelgames.Environment.Example_App",
        "source": "./page/source",
        "config": {
            "page": {
                "port": 8088,
                "mimeTypeMapping": {}
            },
            "build": {
                "files": {
                    "./page/source/index.ts": { "type": "page", "output": "./page/bundle/app.js" },
                    "./desktop/source/index.ts": {
                        "type": "desktop",
                        "name": "KartoffelGames Example App",
                        "identifier": "com.kartoffelgames.example-app",
                        "backend": "webview",
                        "output": {
                            "x86_64-pc-windows-msvc": { "directory": "./dist/windows/ExampleApp", "extension": "raw" },
                            "aarch64-apple-darwin": { "directory": "./dist/macos-arm/ExampleApp", "extension": "app" },
                            "x86_64-apple-darwin": { "directory": "./dist/macos-intel/ExampleApp", "extension": "raw" },
                            "x86_64-unknown-linux-gnu": { "directory": "./dist/linux/ExampleApp", "extension": "raw" }
                        },
                        "include": [
                            { "directory": "./page", "filter": ["**/*.html", "**/*.css", "**/*.js"] }
                        ]
                    }
                }
            }
        }
    }
}

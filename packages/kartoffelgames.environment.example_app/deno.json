{
    "name": "@kartoffelgames/environment-example-app",
    "version": "5.0.1",
    "license": "LGPL-3.0-only",
    "tasks": {},
    "exports": "./page/source/index.ts",
    "imports": {},
    "kg": {
        "name": "Kartoffelgames.Environment.Example_App",
        "source": "./page/source",
        "config": {
            "page": {
                "port": 8088,
                "mimeTypeMapping": {}
            },
            "build": {
                "files": {
                    "./page/source/index.ts": { "type": "page", "output": "./page/bundle/app.js" },
                    "./desktop/source/index.ts": {
                        "type": "desktop",
                        "name": "KartoffelGames Example App",
                        "identifier": "com.kartoffelgames.example-app",
                        "output": {
                            "windows": "./dist/windows/ExampleApp.msi",
                            "macosArm": "./dist/macos-arm/ExampleApp.app",
                            "macosIntel": "./dist/macos-intel/ExampleApp.app",
                            "linux": "./dist/linux/ExampleApp.AppImage"
                        }
                    }
                }
            }
        }
    }
}

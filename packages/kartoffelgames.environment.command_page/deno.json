{
    "name": "@kartoffelgames/environment-command-page",
    "version": "5.0.1",
    "license": "LGPL-3.0-only",
    "tasks": {},
    "imports": {
        "@std/expect": "jsr:@std/expect@^1.0.13"
    },
    "exports": {
        ".": "./source/index.ts",
        "./kg-cli.config.json": "./kg-cli.config.json"
    },
    "publish": {
        "include": [
            "source/",
            "deno.json",
            "kg-cli.config.json",
            "LICENSE"
        ]
    },
    "kg": {
        "name": "Kartoffelgames.Environment.Command_Page",
        "config": {
            "page": {
                "port": 8088,
                "mimeTypeMapping": {},
                "directory": "./page"
            },
            "scratchpad": {
                "port": 8888,
                "mimeTypeMapping": {},
                "build": false,
                "directory": "./scratchpad"
            },
            "package-blueprint": "",
            "test": {
                "directory": "./test"
            },
            "transform": {
                "enableNode": false,
                "nodeDirectory": "./node"
            },
            "build": {
                "files": {}
            }
        },
        "source": "./source"
    }
}